{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "reckoner",
  "version": "0.1.0",
  "identifier": "com.reckoner.app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "reckoner",
        "width": 1400,
        "height": 900,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "../../backend_dist/reckoner_api/reckoner_api"
    ]
  },
  "plugins": {
    "shell": {
      "open": false
    }
  }
}